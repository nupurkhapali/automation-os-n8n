      "parameters": {
        "jsCode": "const q = $('Route').first().json;\nconst r = $input.first().json;\nlet reply;\nif (!r.sku) reply = \"I couldn't find \" + q.sku + '. Please check the code, for example SKU-102.';\nelse {\n  const low = Number(r.stock) <= Number(r.reorder_level);\n  reply = r.product + ' (' + r.sku + ')\\nIn stock: ' + r.stock + ' units\\nPrice: AED ' + r.price_aed + (low ? '\\nLow stock: reorder in progress.' : '');\n}\nreturn [{ json: { reply, chat_id: q.chat_id, sent_at: q.sent_at, workflow: 'order-inventory-bot', business: 'store', minutes_saved: 3, handled_by: 'agent', question: q.text } }];"
      },
