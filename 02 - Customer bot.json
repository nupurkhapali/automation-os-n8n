      "parameters": {
        "jsCode": "const m = $('Telegram Trigger').first().json.message;\nconst text = (m.text || '').trim();\nlet route = 'support', sku = '', order = '';\nconst s = text.match(/sku[-\\s]?(\\d+)/i);\nconst o = text.match(/(?:ord[-\\s]?|order\\s*#?\\s*)(\\d{4})/i);\nif (s) { route = 'inventory'; sku = 'SKU-' + s[1]; }\nelse if (o) { route = 'order'; order = 'ORD-' + o[1]; }\nreturn [{ json: { route, sku, order, text, chat_id: m.chat.id, sent_at: m.date, first_name: (m.from && m.from.first_name) || '' } }];"
      },
