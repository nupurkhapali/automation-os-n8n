    {
      "parameters": {
        "jsCode": "// The Slack handoff step replaces the item with Slack's own response,\n// so fall back to the Parse answer data when chat_id is missing.\nconst incoming = $input.first().json;\nconst j = incoming.chat_id !== undefined ? incoming : $('Parse answer').first().json;\nconst q = $('Route').first().json;\nreturn [{ json: {\n  reply: j.reply,\n  chat_id: j.chat_id,\n  question: j.question,\n  handled_by: j.handled_by,\n  handoff: j.handoff === true || j.handled_by === 'human',\n  workflow: j.workflow,\n  business: j.business,\n  minutes_saved: j.minutes_saved,\n  sent_at: j.sent_at,\n  response_sec: Math.max(1, Math.round(Date.now() / 1000 - q.sent_at))\n} }];"
      },
