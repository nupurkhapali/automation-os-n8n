    {
      "parameters": {
        "jsCode": "const k = $input.first().json;\nconst g = k.group.kpis, A = k.group.automation, L = [];\nL.push('Period: ' + k.window.from + ' to ' + k.window.to);\nL.push('Group: revenue AED ' + g.revenue + ' (' + g.revenue_change_pct + '% vs prior 30 days), orders and deals ' + g.orders + ', leads ' + g.leads + ', net cash AED ' + g.net_cash);\nObject.values(k.businesses).forEach((b) => {\n  const x = b.kpis;\n  L.push(b.name + ': revenue AED ' + x.revenue + ' (' + x.revenue_change_pct + '%), orders ' + x.orders + ', leads ' + x.leads + ', conversion ' + x.conversion_pct + '%, first reply ' + x.first_response_min + ' min, net cash AED ' + x.net_cash);\n});\nconst low = (k.businesses.store.low_stock || []).map((s) => s.product + ' (' + s.stock + ' left, reorder at ' + s.reorder_level + ')').join('; ');\nL.push('Low stock: ' + (low || 'none'));\nL.push('Automation: ' + A.hours_saved_30d + ' hours saved in 30 days, ' + A.agent_share_pct + '% of tickets resolved by the agent');\nreturn [{ json: { summary_input: L.join('\\n') } }];"
      },
